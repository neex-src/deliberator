# Tellij workbench — one order through the demo stack.
# Ctrl+Enter runs the block under the caret, Ctrl+Shift+Enter runs everything, Esc stops.
# @var orderId = ord-{{uuid}}
# @var customer = alice
# @connect kafka local bootstrap=localhost:9092 simulate=true latency=400ms

### kafka orders
# @key {{orderId}}
{ "orderId": "{{orderId}}", "customer": "{{customer}}", "amount": 42.5 }

### kafka payments
{ "orderId": "{{orderId}}", "status": "PAID", "paidAt": "{{now}}" }
