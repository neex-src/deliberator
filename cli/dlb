#!/usr/bin/env bb
;; dlb: the Deliberator command line. argv -> one request to deliberatord -> printed summary.
;; All code is in cli/src/dlb/*.clj, found next to this script's real location (symlinks resolved).
(require '[babashka.fs :as fs] '[babashka.classpath :as cp])
(let [dir (str (fs/parent (fs/real-path *file*)))]
  (cp/add-classpath (str dir "/src"))
  (require 'dlb.main)
  (let [code ((resolve 'dlb.main/-main) dir *command-line-args*)]
    (flush)
    (System/exit code)))
