;; What service A is; `service.adopt` copies it into the workspace as services/a.edn.
{:name "a"
 :kind :spring-boot
 :build {:cmd ["mvn" "-q" "-DskipTests" "-pl" "service-a" "-am" "package"]
         :dir ".."
         :artifact "target/service-a-0.1.0.jar"
         :java 21}
 ;; no :image = the hotswap image (estate/images/hotswap); :image "docker.io/library/eclipse-temurin:21-jre" runs the plain JRE (JDWP reload, body changes only)
 :main "estate.a.ServiceA"
 :reload {:modules ["common"]}
 :port 8081
 :jdwp 5005
 :health "/actuator/health"
 :taskdef {:module "estate/terraform/modules/stack" :container "service-a" :key "a"}}
