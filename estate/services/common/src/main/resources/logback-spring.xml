<?xml version="1.0" encoding="UTF-8"?>
<!-- One text line per event, correlation id included; the same line to CloudWatch Logs when logging.cloudwatch.group is set. -->
<configuration>
  <springProperty name="LOG_GROUP" source="logging.cloudwatch.group" defaultValue=""/>
  <springProperty name="APP" source="spring.application.name" defaultValue="app"/>
  <property name="PATTERN" value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level ${APP} [%X{correlation:-}] %logger{36}:%line - %msg%n"/>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>${PATTERN}</pattern></encoder>
  </appender>
  <appender name="CLOUDWATCH" class="estate.common.CloudWatchLogsAppender">
    <group>${LOG_GROUP}</group>
    <encoder><pattern>${PATTERN}</pattern></encoder>
  </appender>
  <root level="INFO">
    <appender-ref ref="STDOUT"/>
    <appender-ref ref="CLOUDWATCH"/>
  </root>
</configuration>
