<idea-plugin>
    <!-- Loaded only when the Java plugin is present. -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- Debug of a "Deliberator Service" configuration: service.start, then the platform attaches to its JDWP port (m3 piece 06) -->
        <programRunner implementation="com.neex.deliberator.services.ServiceDebugRunner" order="first"/>
    </extensions>
    <actions>
        <action id="deliberator.marker.logpoint" class="com.neex.deliberator.services.AddLogpointAction" text="Add Logging Breakpoint (No Suspend)"
                description="A line breakpoint that logs an expression and does not suspend: evidence that a line is hit while a service is attached under the debugger">
            <add-to-group group-id="deliberator.logs" anchor="last"/>
            <add-to-group group-id="EditorGutterPopupMenu" anchor="last"/>
        </action>
    </actions>
    <extensions defaultExtensionNs="com.neex.deliberator">
        <loggerResolver implementation="com.neex.deliberator.logs.JavaLoggerResolver"/>
        <classLocator implementation="com.neex.deliberator.logs.JavaClassLocator"/>
    </extensions>
</idea-plugin>
