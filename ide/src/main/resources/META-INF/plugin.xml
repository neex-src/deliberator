<idea-plugin>
    <id>com.neex.deliberator</id>
    <name>Deliberator</name>
    <vendor email="dev@neex.dev">NEEX</vendor>
    <description><![CDATA[
        Deliberating a microservice and event-driven AWS estate from the IDE: the plugin talks to the
        <code>deliberatord</code> daemon it ships, which runs on the IDE's own runtime.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="deliberator-java.xml">com.intellij.java</depends>
    <depends optional="true" config-file="deliberator-gradle.xml">com.intellij.gradle</depends>
    <depends optional="true" config-file="deliberator-maven.xml">org.jetbrains.idea.maven</depends>
    <depends optional="true" config-file="deliberator-properties.xml">com.intellij.properties</depends>
    <depends optional="true" config-file="deliberator-yaml.xml">org.jetbrains.plugins.yaml</depends>
    <depends optional="true" config-file="deliberator-json.xml">com.intellij.modules.json</depends>

    <extensionPoints>
        <extensionPoint name="repositoryKind" interface="com.neex.deliberator.repo.RepositoryKind" dynamic="true"/>
        <extensionPoint name="loggerResolver" interface="com.neex.deliberator.logs.LoggerResolver" dynamic="true"/>
        <extensionPoint name="classLocator" interface="com.neex.deliberator.logs.ClassLocator" dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.neex.deliberator.daemon.DaemonService"/>
        <applicationService serviceImplementation="com.neex.deliberator.daemon.DeliberatorSettings"/>
        <applicationConfigurable parentId="tools" instanceId="deliberator" displayName="Deliberator"
                                 id="deliberator.settings" instance="com.neex.deliberator.daemon.DeliberatorConfigurable"/>
        <projectService serviceImplementation="com.neex.deliberator.workspace.WorkspaceService"/>
        <projectService serviceImplementation="com.neex.deliberator.repo.RepositoryAttacher"/>
        <postStartupActivity implementation="com.neex.deliberator.repo.ReattachOnOpen"/>
        <toolWindow id="Deliberator" anchor="right" secondary="false" canCloseContents="false"
                    factoryClass="com.neex.deliberator.ui.DeliberatorToolWindowFactory"/>
        <notificationGroup id="Deliberator" displayType="BALLOON"/>

        <!-- the .scn language (piece 05) -->
        <fileType name="Deliberator Scenario" language="Deliberator.Scn" extensions="scn"
                  implementationClass="com.neex.deliberator.scn.ScnFileType" fieldName="INSTANCE"/>
        <applicationService serviceImplementation="com.neex.deliberator.scn.ScnRegistry"/>
        <lang.parserDefinition language="Deliberator.Scn" implementationClass="com.neex.deliberator.scn.ScnParserDefinition"/>
        <lang.syntaxHighlighterFactory language="Deliberator.Scn" implementationClass="com.neex.deliberator.scn.ScnSyntaxHighlighterFactory"/>
        <colorSettingsPage implementation="com.neex.deliberator.scn.ScnColorSettingsPage"/>
        <annotator language="Deliberator.Scn" implementationClass="com.neex.deliberator.scn.ScnHeadAnnotator"/>
        <externalAnnotator language="Deliberator.Scn" implementationClass="com.neex.deliberator.scn.ScnExternalAnnotator"/>
        <lang.foldingBuilder language="Deliberator.Scn" implementationClass="com.neex.deliberator.scn.ScnFoldingBuilder"/>
        <lang.psiStructureViewFactory language="Deliberator.Scn" implementationClass="com.neex.deliberator.scn.ScnStructureViewFactory"/>
        <completion.contributor language="Deliberator.Scn" implementationClass="com.neex.deliberator.scn.ScnCompletionContributor"/>
        <editorFactoryListener implementation="com.neex.deliberator.scn.ScnEditorListener"/>
        <typedHandler implementation="com.neex.deliberator.scn.ScnAutoPopup"/>
        <multiHostInjector implementation="com.neex.deliberator.scn.ScnJsonInjector"/>
        <lang.elementManipulator forClass="com.neex.deliberator.scn.ScnBody" implementationClass="com.neex.deliberator.scn.ScnBodyManipulator"/>

        <!-- running from the editor (piece 06) -->
        <projectService serviceImplementation="com.neex.deliberator.run.ScnRunner"/>
        <editorFactoryListener implementation="com.neex.deliberator.run.RunEditorListener"/>

        <!-- logs and markers (piece 07) -->
        <projectService serviceImplementation="com.neex.deliberator.logs.MarkerService"/>
        <projectService serviceImplementation="com.neex.deliberator.logs.LogMatcher"/>
        <projectService serviceImplementation="com.neex.deliberator.logs.LogService"/>
        <projectService serviceImplementation="com.neex.deliberator.logs.LogLinks"/>
        <editorFactoryListener implementation="com.neex.deliberator.logs.LogsEditorListener"/>
        <editorNotificationProvider implementation="com.neex.deliberator.logs.TruncatedLogBanner"/>

        <!-- services: the tab, the run configuration (m3 piece 06); the debug runner lives in deliberator-java.xml -->
        <projectService serviceImplementation="com.neex.deliberator.services.ServiceOps"/>

        <!-- repositories, worktrees, pull requests (M5.1, M5.5) and the CI view (M5.2-M5.4) -->
        <projectService serviceImplementation="com.neex.deliberator.work.WorkOps"/>
        <projectService serviceImplementation="com.neex.deliberator.ci.CiOps"/>
        <projectService serviceImplementation="com.neex.deliberator.services.ServiceConsoles"/>
        <configurationType implementation="com.neex.deliberator.services.ServiceRunConfigurationType"/>

        <!-- the config chain (m3 piece 07); the references live in deliberator-properties.xml and deliberator-yaml.xml -->
        <projectService serviceImplementation="com.neex.deliberator.config.ConfigChains"/>
        <projectService serviceImplementation="com.neex.deliberator.config.ConfigViews"/>
        <editorNotificationProvider implementation="com.neex.deliberator.config.ConfigViewBanner"/>
        <editorNotificationProvider implementation="com.neex.deliberator.scn.RemoteEnvBanner"/>

        <!-- remote environments (m4): audit trail view, Logs Insights result banner -->
        <projectService serviceImplementation="com.neex.deliberator.environments.AuditViews"/>
        <editorNotificationProvider implementation="com.neex.deliberator.environments.AuditBanner"/>
        <projectService serviceImplementation="com.neex.deliberator.logs.InsightsViews"/>
        <editorNotificationProvider implementation="com.neex.deliberator.logs.InsightsBanner"/>
        <localInspection shortName="DeliberatorConfigChain" displayName="Broken configuration chain" groupName="Deliberator"
                         enabledByDefault="true" level="WARNING" implementationClass="com.neex.deliberator.config.ConfigChainInspection"/>
    </extensions>

    <applicationListeners>
        <listener class="com.neex.deliberator.logs.MarkerSaveSync" topic="com.intellij.openapi.fileEditor.FileDocumentManagerListener"/>
    </applicationListeners>

    <extensions defaultExtensionNs="com.neex.deliberator">
        <repositoryKind implementation="com.neex.deliberator.repo.PlainKind"/>
    </extensions>

    <actions>
        <group id="deliberator.menu" text="Deliberator" popup="true">
            <add-to-group group-id="MainMenu" anchor="before" relative-to-action="HelpMenu"/>
            <action id="deliberator.daemon.status" class="com.neex.deliberator.actions.DaemonStatusAction"
                    text="Daemon Status" description="Find or start the Deliberator daemon and show its version and endpoint"/>
            <action id="deliberator.workspace.open" class="com.neex.deliberator.actions.OpenWorkspaceAction"
                    text="Open Workspace..." description="Open the project directory of a workspace (created through the daemon)"/>
            <action id="deliberator.workspace.bind" class="com.neex.deliberator.actions.BindWorkspaceAction"
                    text="Use Workspace for This Project..." description="Bind the current project to a workspace"/>
            <action id="deliberator.repo.attach" class="com.neex.deliberator.actions.AttachRepositoryAction"
                    text="Attach Repository..." description="Add a directory (Gradle, Maven or plain) to this project without reopening it"/>
            <action id="deliberator.repo.detach" class="com.neex.deliberator.actions.DetachRepositoryAction"
                    text="Detach Repository..." description="Remove an attached repository from this project (files untouched)"/>
            <action id="deliberator.env.create" icon="AllIcons.General.Add" class="com.neex.deliberator.environments.NewEnvironmentAction"
                    text="New Environment..." description="env.create: a remote environment from an AWS profile, an account and a region (the account is checked first)"/>
            <action id="deliberator.audit.open" class="com.neex.deliberator.environments.OpenAuditLogAction"
                    text="Open Audit Log..." description="audit.show: the audit trail of a session as text, the confirmations highlighted"/>
            <action id="deliberator.universal.open" icon="AllIcons.FileTypes.Json" class="com.neex.deliberator.run.OpenUniversalAction"
                    text="Open Universal JSON" description="workspace.universal: writes everything the model gets when it writes steps (operations, kinds, targets, services, Terraform, skills) for the selected environment, and opens it"/>
            <action id="deliberator.ops.show" icon="AllIcons.Actions.Edit" class="com.neex.deliberator.actions.OperationsAction"
                    text="Operations..." description="Every daemon operation with a generated form"/>
        </group>
        <group id="deliberator.scenario" text="Deliberator Scenario" popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <add-to-group group-id="deliberator.menu" anchor="last"/>
            <action id="deliberator.scenario.runStep" class="com.neex.deliberator.run.RunStepAction"
                    text="Run Step at Caret" description="Run the step at the caret (scenario.run steps [n])">
                <keyboard-shortcut keymap="$default" first-keystroke="control ENTER"/>
            </action>
            <action id="deliberator.scenario.runFrom" class="com.neex.deliberator.run.RunFromHereAction"
                    text="Run From Step at Caret" description="Run the step at the caret and every step after it"/>
            <action id="deliberator.scenario.runAll" class="com.neex.deliberator.run.RunAllAction"
                    text="Run Scenario" description="Run every step of this scenario"/>
            <action id="deliberator.scenario.cancel" class="com.neex.deliberator.run.CancelRunAction"
                    text="Cancel Run" description="Cancel the run of this scenario (only while it runs)">
                <keyboard-shortcut keymap="$default" first-keystroke="ESCAPE"/>
            </action>
            <action id="deliberator.scenario.toggleResults" class="com.neex.deliberator.run.ToggleResultsAction"
                    text="Expand/Collapse Inline Results" description="Show or hide the full text of every inline step result"/>
            <action id="deliberator.scenario.peekResponse" class="com.neex.deliberator.run.PeekResponseAction"
                    text="Peek Response" description="The response of the step at the caret, readable; Enter adds an @assert for the line">
                <keyboard-shortcut keymap="$default" first-keystroke="control alt ENTER"/>
            </action>
            <action id="deliberator.scenario.pasteAwsCli" class="com.neex.deliberator.run.PasteAwsCliAction"
                    text="Paste aws CLI Command as Step" description="The clipboard holds an `aws service operation --flag value` command: it becomes an aws step"/>
            <action id="deliberator.scenario.copyAsCli" class="com.neex.deliberator.run.CopyStepAsCliAction"
                    text="Copy Step as aws CLI Command" description="The aws step at the caret as an aws CLI command on the clipboard"/>
            <action id="deliberator.scenario.fillBody" class="com.neex.deliberator.run.FillAwsBodyAction"
                    text="Fill Request Body" description="Put the required members of the aws operation at the caret into the step body"/>
            <action id="deliberator.scenario.generate" class="com.neex.deliberator.run.GenerateStepsAction" icon="AllIcons.Actions.IntentionBulb"
                    text="Generate Steps for AI Block" description="The caret is in an ai block (### ai name and prose): a model writes the steps under the prose, Deliberator checks them (scenario.generate)"/>
            <action id="deliberator.scenario.runs" class="com.neex.deliberator.run.RunHistoryAction"
                    text="Runs of This Scenario..." description="History of this scenario: open result.txt, show inline, diff two runs"/>
        </group>
        <group id="deliberator.logs" text="Deliberator Logs and Markers" popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <add-to-group group-id="deliberator.menu" anchor="last"/>
            <action id="deliberator.logs.fetch" class="com.neex.deliberator.logs.FetchLogsAction"
                    text="Fetch Logs..." description="logs.fetch of a target of the selected environment; opens the file the daemon wrote"/>
            <action id="deliberator.logs.filter" class="com.neex.deliberator.logs.FilterByCorrelationAction"
                    text="Filter Log by Correlation" description="Fold the entries without the correlation id (selection, else the latest run's id, else asks)"/>
            <action id="deliberator.logs.unfilter" class="com.neex.deliberator.logs.ClearCorrelationFilterAction"
                    text="Clear Correlation Filter" description="Unfold the entries the filter folded"/>
            <action id="deliberator.logs.match" class="com.neex.deliberator.logs.MatchMarkersAction"
                    text="Match Markers in Open Logs" description="logs.match on every open log file and highlight the matching lines"/>
            <action id="deliberator.logs.gotoSource" class="com.neex.deliberator.logs.GoToSourceFromLogAction"
                    text="Go to Source of Log Line" description="The place on this log line that names code of an attached repository (a stack frame, a logger:line, a Node frame) opens its source; the same as Ctrl+click on the underlined text"/>
            <action id="deliberator.logs.links" class="com.neex.deliberator.logs.UpdateLogLinksAction"
                    text="Update Source Links in Log" description="logs.refs: ask the daemon again which places of this log name code (after attaching a repository)"/>
            <action id="deliberator.logs.insights" class="com.neex.deliberator.logs.FindInCloudWatchAction"
                    text="Find in CloudWatch Logs..." description="The selection (an exception class or message) searched with Logs Insights in the log groups of the selected environment's service; the result opens as text with the bytes scanned in a banner"/>
            <action id="deliberator.marker.toggle" class="com.neex.deliberator.logs.ToggleMarkerAction"
                    text="Add Deliberator Marker" description="Mark this source line: log lines of its class and line are highlighted in fetched logs">
                <add-to-group group-id="EditorGutterPopupMenu" anchor="first"/>
            </action>
        </group>
        <group id="deliberator.config" text="Deliberator Config Chain" popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <add-to-group group-id="deliberator.menu" anchor="last"/>
            <action id="deliberator.config.chain" class="com.neex.deliberator.config.ConfigChainAction"
                    text="Show Config Chain" description="The whole config chain of this file's service in the selected environment, as text (config.chain)"/>
            <action id="deliberator.config.refresh" class="com.neex.deliberator.config.ConfigRefreshAction"
                    text="Refresh Config Snapshot" description="config.refresh: fetch the parameters and secret metadata of the selected environment into the cached snapshot"/>
        </group>
        <group id="deliberator.services" text="Deliberator Services" popup="true">
            <add-to-group group-id="deliberator.menu" anchor="last"/>
            <action id="deliberator.service.start" icon="AllIcons.Actions.Execute" class="com.neex.deliberator.services.ServiceStartAction"
                    text="Start" description="service.start: create or start the container and wait until healthy"/>
            <action id="deliberator.service.stop" icon="AllIcons.Actions.Suspend" class="com.neex.deliberator.services.ServiceStopAction"
                    text="Stop" description="service.stop: stop the container, keep it"/>
            <action id="deliberator.service.restart" icon="AllIcons.Actions.Restart" class="com.neex.deliberator.services.ServiceRestartAction"
                    text="Restart" description="service.restart: stop, then start (a rebuilt jar recreates the container)"/>
            <action id="deliberator.service.reload" icon="AllIcons.Actions.ForceRefresh" class="com.neex.deliberator.services.ServiceReloadAction"
                    text="Reload" description="service.reload: compile and bring the changed classes into the running container"/>
            <action id="deliberator.service.debug" icon="AllIcons.Actions.StartDebugger" class="com.neex.deliberator.services.ServiceDebugAction"
                    text="Debug" description="Start the service and attach the IDE's debugger to its JDWP port"/>
            <action id="deliberator.service.logs" icon="AllIcons.Actions.ShowAsTree" class="com.neex.deliberator.services.ServiceLogsAction"
                    text="Log" description="logs.fetch of the service's container log, opened in the editor"/>
            <action id="deliberator.service.dev" icon="AllIcons.Actions.Rollback" class="com.neex.deliberator.services.ServiceDevAction"
                    text="Back to Dev Container" description="service.dev: a service bound to an ECS service runs your build again instead of the deployed revision's image, held until the next revision"/>
            <action id="deliberator.service.build" icon="AllIcons.Actions.Compile" class="com.neex.deliberator.services.ServiceBuildAction"
                    text="Build" description="service.build"/>
            <action id="deliberator.topology.set" icon="AllIcons.General.Web" class="com.neex.deliberator.services.TopologySetAction"
                    text="Topology..." description="topology.set in the selected environment: local, external or off"/>
            <separator/>
            <action id="deliberator.fake.record" icon="AllIcons.Debugger.Db_set_breakpoint" class="com.neex.deliberator.services.FakeRecordAction"
                    text="Record Fake..." description="fake.record: an HTTP fake in front of a service or URL records every exchange raw under the session"/>
            <action id="deliberator.fake.replay" icon="AllIcons.Actions.Rerun" class="com.neex.deliberator.services.FakeReplayAction"
                    text="Replay Fake" description="fake.replay: the fake serves a recording (the selected one, else the newest)"/>
            <action id="deliberator.fake.stop" icon="AllIcons.Actions.Suspend" class="com.neex.deliberator.services.FakeStopAction"
                    text="Stop Fake" description="fake.stop: the fake's container goes, the services attached to it are local again"/>
            <separator/>
            <action id="deliberator.service.adopt" icon="AllIcons.General.Add" class="com.neex.deliberator.services.ServiceAdoptAction"
                    text="Adopt Service..." description="service.adopt: take a module directory (its deliberator-service.edn) into the workspace"/>
        </group>
        <group id="deliberator.work" text="Deliberator Work" popup="true">
            <add-to-group group-id="deliberator.menu" anchor="last"/>
            <action id="deliberator.work.start" icon="AllIcons.General.Add" class="com.neex.deliberator.work.StartWorkingAction"
                    text="Start Working..." description="worktree.start: a repository (clone one by URL if needed) and a branch; a fresh worktree from the latest main, attached to this project"/>
            <action id="deliberator.work.clone" icon="AllIcons.Actions.Download" class="com.neex.deliberator.work.CloneRepositoryAction"
                    text="Clone Repository..." description="repo.clone: a bare clone of a git URL in the workspace (Start Working makes a worktree of it)"/>
            <action id="deliberator.pr.open" icon="AllIcons.Vcs.Merge" class="com.neex.deliberator.work.OpenPrAction"
                    text="Open Pull Request..." description="pr.open: a pull request as a worktree, attached; its review comments and checks open as text"/>
            <action id="deliberator.work.remove" icon="AllIcons.General.Remove" class="com.neex.deliberator.work.RemoveWorktreeAction"
                    text="Remove Worktree" description="worktree.remove: the worktree directory (refused with changes unless confirmed); the branch stays"/>
            <action id="deliberator.work.refresh" icon="AllIcons.Actions.Refresh" class="com.neex.deliberator.work.RefreshWorkAction"
                    text="Refresh" description="repo.list and worktree.list"/>
        </group>
        <group id="deliberator.ci" text="Deliberator CI" popup="true">
            <add-to-group group-id="deliberator.menu" anchor="last"/>
            <action id="deliberator.ci.open" icon="AllIcons.Actions.Show" class="com.neex.deliberator.ci.CiOpenAction"
                    text="Open" description="Enter: a step or a job opens its log; a run its default action (red: ci.diff against the last green run, running: followed, others: their log)"/>
            <action id="deliberator.ci.jobLog" icon="AllIcons.Actions.ListFiles" class="com.neex.deliberator.ci.CiJobLogAction"
                    text="Open Log" description="ci.log of the step (its lines only), of the job, or of a job of the run to choose; a job that still runs is followed"/>
            <action id="deliberator.ci.diff" icon="AllIcons.Actions.Diff" class="com.neex.deliberator.ci.CiDiffAction"
                    text="Diff Against Last Green" description="ci.diff: the failed step (or job) against the same of the last green run, normalised"/>
            <action id="deliberator.ci.runLocally" icon="AllIcons.Actions.Lightning" class="com.neex.deliberator.ci.RunLocallyAction"
                    text="Run Locally..." description="The selected workflow runs on this machine with act: the event, one job or all, the dispatch inputs; the run appears on top of its workflow as local #n"/>
            <action id="deliberator.ci.cancelLocal" icon="AllIcons.Actions.Suspend" class="com.neex.deliberator.ci.CiCancelLocalAction"
                    text="Cancel Local Run" description="Stops the local run (act and its containers); the run ends cancelled"/>
            <action id="deliberator.ci.follow" icon="AllIcons.Actions.Execute" class="com.neex.deliberator.ci.CiFollowAction"
                    text="Follow" description="ci.tail: a running job's lines in a console tab, then its whole log"/>
            <action id="deliberator.ci.browser" icon="AllIcons.General.Web" class="com.neex.deliberator.ci.CiBrowserAction"
                    text="Open in Browser" description="The run, job or step on the page of the CI system"/>
            <action id="deliberator.ci.copy" icon="AllIcons.Actions.Copy" class="com.neex.deliberator.ci.CiCopyAction"
                    text="Copy as Text" description="The row as text; a run with its jobs and steps"/>
            <action id="deliberator.ci.runsText" icon="AllIcons.FileTypes.Text" class="com.neex.deliberator.ci.CiRunsTextAction"
                    text="Open Runs Text" description="The text file ci.runs wrote for the repository (one line per run)"/>
            <action id="deliberator.ci.refresh" icon="AllIcons.Actions.Refresh" class="com.neex.deliberator.ci.CiRefreshAction"
                    text="Refresh Runs" description="ci.runs of the selected repository"/>
            <action id="deliberator.ci.addRepo" icon="AllIcons.General.Add" class="com.neex.deliberator.ci.CiAddRepoAction"
                    text="Add Repository..." description="A GitHub repository (owner/name) to list next to the workspace's clones"/>
            <action id="deliberator.ci.removeRepo" icon="AllIcons.General.Remove" class="com.neex.deliberator.ci.CiRemoveRepoAction"
                    text="Remove Repository" description="Forget a repository added to this view"/>
            <separator/>
            <action id="deliberator.ci.localWorkflow" icon="AllIcons.Actions.Lightning" class="com.neex.deliberator.ci.RunWorkflowLocallyAction"
                    text="Run Workflow Locally" description="ci.local: every job of the workflow in the editor in needs order with act on the runtime's container engine; the dialog asks for the event and the inputs">
                <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            </action>
            <action id="deliberator.ci.local" icon="AllIcons.Actions.Lightning" class="com.neex.deliberator.ci.RunJobLocallyAction"
                    text="Run Job Locally" description="ci.local: the workflow job at the caret runs with act on the runtime's container engine against the local endpoint; live output in a console tab">
                <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            </action>
        </group>
        <!-- piece 04 stage 2: the deployments of the Environments tab -->
        <group id="deliberator.deploy" text="Deliberator Deployments" popup="true">
            <action id="deliberator.deploy.follow" icon="AllIcons.Actions.Execute" class="com.neex.deliberator.environments.DeployFollowAction"
                    text="Follow Deploy" description="deploy.follow: a rollout's events, tasks and container lines in a console tab until it ends; the deploy text opens beside it and grows"/>
            <action id="deliberator.deploy.text" icon="AllIcons.Actions.Show" class="com.neex.deliberator.environments.DeployOpenTextAction"
                    text="Open Deploy Text" description="deploy.show: the deployment as one text: header, events, tasks, the containers' log lines"/>
            <action id="deliberator.deploy.logs" icon="AllIcons.Actions.ShowAsTree" class="com.neex.deliberator.environments.DeployLogsAction"
                    text="Container Logs of This Deployment" description="The log lines of the containers of the tasks this deployment started: the deploy text at its log section"/>
            <action id="deliberator.deploy.ciRun" icon="AllIcons.Vcs.History" class="com.neex.deliberator.environments.DeployCiRunAction"
                    text="Open CI Run" description="Select the CI run that made this revision (task definition tag run-id) in the CI tab"/>
            <action id="deliberator.deploy.refresh" icon="AllIcons.Actions.Refresh" class="com.neex.deliberator.environments.DeployRefreshAction"
                    text="Refresh Deployments" description="deploy.list of the chosen service: asks AWS (read calls only); the table shows the cached answer until then"/>
        </group>
        <group id="deliberator.explorer" text="Deliberator Explorer" popup="true">
            <action id="deliberator.explorer.serviceLog" icon="AllIcons.Actions.ShowAsTree" class="com.neex.deliberator.explorer.OpenLinkedLogAction"
                    text="Open Service Log" description="logs.fetch of the log/ target service.list names for the service this row belongs to"/>
            <action id="deliberator.explorer.serviceRow" icon="AllIcons.Nodes.Services" class="com.neex.deliberator.explorer.RevealServiceAction"
                    text="Show Service Container" description="Select the service of this row in the Services tab (its runtime container)"/>
            <action id="deliberator.explorer.declaration" icon="AllIcons.Actions.EditSource" class="com.neex.deliberator.explorer.OpenDeclarationAction"
                    text="Open Terraform Declaration" description="terraform.locate: the .tf file and line that declare this drift row's address"/>
        </group>
        <!-- piece 04 stage 2: the CI tab's Open Deployment (its own file, registered into the CI group) -->
        <action id="deliberator.deploy.openFromCi" icon="AllIcons.Actions.Forward" class="com.neex.deliberator.environments.OpenDeploymentAction"
                text="Open Deployment" description="deploy.where: the deployment that carries this run's commit; its deploy text opens">
            <add-to-group group-id="deliberator.ci" anchor="last"/>
        </action>
        <group id="deliberator.toolwindow.actions">
            <action id="deliberator.workspace.create" icon="AllIcons.General.Add" class="com.neex.deliberator.actions.CreateWorkspaceAction" text="Open Workspace" description="The workspace of this project does not exist yet: workspace.open creates it"/>
            <action id="deliberator.workspace.refresh" icon="AllIcons.Actions.Refresh" class="com.neex.deliberator.actions.RefreshAction" text="Refresh" description="Re-read the workspace from the daemon"/>
