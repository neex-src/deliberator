COMMENT '# the five AWS kinds in one run: queue, event bus + rule, function, table, schedule'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@env'
WHITE_SPACE ' '
DIR_VALUE 'local'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@var'
WHITE_SPACE ' '
DIR_VALUE 'schedule = dlbtest-sched'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'sqs'
WHITE_SPACE ' '
WORD 'send'
WHITE_SPACE ' '
TARGET 'queue/in'
WHITE_SPACE ' '
WORD 'send-order'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@attr'
WHITE_SPACE ' '
DIR_VALUE 'channel=fixture'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'messageId matches /^[0-9a-f-]{36}$/'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'md5 matches /^[0-9a-f]{32}$/'
EOL '\n'
BODY '{"order": "A-1", "qty": 2}'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'sqs'
WHITE_SPACE ' '
WORD 'receive'
WHITE_SPACE ' '
TARGET 'queue/in'
WHITE_SPACE ' '
WORD 'receive-order'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@max'
WHITE_SPACE ' '
DIR_VALUE '5'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'count == 1'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$[0].order == A-1'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$[0].qty == 2'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@capture'
WHITE_SPACE ' '
DIR_VALUE 'order = $[0].order'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'sqs'
WHITE_SPACE ' '
WORD 'receive'
WHITE_SPACE ' '
TARGET 'queue/in'
WHITE_SPACE ' '
WORD 'drained'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@wait'
WHITE_SPACE ' '
DIR_VALUE '1s'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'count == 0'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'eventbridge'
WHITE_SPACE ' '
WORD 'put'
WHITE_SPACE ' '
TARGET 'bus/test'
WHITE_SPACE ' '
WORD 'put-event'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@source'
WHITE_SPACE ' '
DIR_VALUE 'dlbtest.fixture'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@detail-type'
WHITE_SPACE ' '
DIR_VALUE 'order.created'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'failed == 0'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'eventId matches /.+/'
EOL '\n'
BODY '{"order": "'
VARIABLE '{{order}}'
BODY '", "qty": 2}'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'sqs'
WHITE_SPACE ' '
WORD 'receive'
WHITE_SPACE ' '
TARGET 'queue/routed'
WHITE_SPACE ' '
WORD 'routed-event'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@until'
WHITE_SPACE ' '
DIR_VALUE 'count == 1 within 5s'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@wait'
WHITE_SPACE ' '
DIR_VALUE '1s'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'count == 1'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$[0].source == dlbtest.fixture'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$[0].detail.order == A-1'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$[0].detail.correlation contains '
VARIABLE '{{correlation}}'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'lambda'
WHITE_SPACE ' '
WORD 'invoke'
WHITE_SPACE ' '
TARGET 'function/fn'
WHITE_SPACE ' '
WORD 'call-function'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'status == 200'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.ok == true'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.echo.hello == world'
EOL '\n'
BODY '{"hello": "world"}'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'lambda'
WHITE_SPACE ' '
WORD 'invoke'
WHITE_SPACE ' '
TARGET 'function/fn'
WHITE_SPACE ' '
WORD 'call-failing'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@log-tail'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'status == 200'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'error == Unhandled'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.errorMessage == kaboom'
EOL '\n'
BODY '{"boom": 1}'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'dynamodb'
WHITE_SPACE ' '
WORD 'get'
WHITE_SPACE ' '
TARGET 'table/t'
WHITE_SPACE ' '
WORD 'get-item'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'count == 1'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.n.N == 5'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.id.S == item-1'
EOL '\n'
BODY '{"Key": {"id": {"S": "item-1"}}}'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'dynamodb'
WHITE_SPACE ' '
WORD 'query'
WHITE_SPACE ' '
TARGET 'table/t'
WHITE_SPACE ' '
WORD 'query-item'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'count == 1'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'scanned == 1'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$[0].n.N == 5'
EOL '\n'
BODY '{"KeyConditionExpression": "id = :i", "ExpressionAttributeValues": {":i": {"S": "item-1"}}}'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'dynamodb'
WHITE_SPACE ' '
WORD 'scan'
WHITE_SPACE ' '
TARGET 'table/t'
WHITE_SPACE ' '
WORD 'scan-all'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'count == 1'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$[0].id.S == item-1'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'scheduler'
WHITE_SPACE ' '
WORD 'list'
WHITE_SPACE ' '
WORD 'list-schedules'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'count == 1'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$[0].Name == '
VARIABLE '{{schedule}}'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'scheduler'
WHITE_SPACE ' '
WORD 'get'
WHITE_SPACE ' '
TARGET 'schedule/s'
WHITE_SPACE ' '
WORD 'get-schedule'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.Name == dlbtest-sched'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.ScheduleExpression contains 2031'
EOL '\n'
