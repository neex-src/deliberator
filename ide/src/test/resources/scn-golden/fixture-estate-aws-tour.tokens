COMMENT '# Any AWS operation as a step: ### aws <service>.<Operation>, the body is the request JSON, $ is the response.'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@env'
WHITE_SPACE ' '
DIR_VALUE 'local'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@var'
WHITE_SPACE ' '
DIR_VALUE 'topic = tour-'
VARIABLE '{{uuid}}'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'aws'
WHITE_SPACE ' '
WORD 'ssm.GetParameter'
WHITE_SPACE ' '
WORD 'table-name'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.Parameter.Value == estate-messages'
EOL '\n'
BODY '{"Name": "/estate/common/table-name"}'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'aws'
WHITE_SPACE ' '
WORD 'sns.CreateTopic'
WHITE_SPACE ' '
WORD 'create-topic'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@capture'
WHITE_SPACE ' '
DIR_VALUE 'arn = $.TopicArn'
EOL '\n'
BODY '{"Name": "'
VARIABLE '{{topic}}'
BODY '"}'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'aws'
WHITE_SPACE ' '
WORD 'sns.Publish'
WHITE_SPACE ' '
WORD 'publish'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.MessageId matches /^[0-9a-f-]{36}$/'
EOL '\n'
BODY '{"TopicArn": "'
VARIABLE '{{arn}}'
BODY '", "Message": "hello from the tour"}'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'aws'
WHITE_SPACE ' '
WORD 's3.CreateBucket'
WHITE_SPACE ' '
WORD 'bucket'
EOL '\n'
BODY '{"Bucket": "'
VARIABLE '{{topic}}'
BODY '", "CreateBucketConfiguration": {"LocationConstraint": "eu-central-1"}}'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'aws'
WHITE_SPACE ' '
WORD 's3.GetBucketLocation'
WHITE_SPACE ' '
WORD 'where'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.LocationConstraint == eu-central-1'
EOL '\n'
BODY '{"Bucket": "'
VARIABLE '{{topic}}'
BODY '"}'
EOL '\n'
