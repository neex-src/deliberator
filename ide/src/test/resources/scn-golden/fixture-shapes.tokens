COMMENT '# order flow, every step shape'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@env'
WHITE_SPACE ' '
DIR_VALUE 'local'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@var'
WHITE_SPACE ' '
DIR_VALUE 'orderId = ord-'
VARIABLE '{{uuid}}'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@var'
WHITE_SPACE ' '
DIR_VALUE 'topic=orders'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'http'
WHITE_SPACE ' '
WORD 'create-order'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'status == 201'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@capture'
WHITE_SPACE ' '
DIR_VALUE 'id = $.orderId'
EOL '\n'
BODY 'POST '
VARIABLE '{{service/a}}'
BODY '/orders'
EOL '\n'
BODY 'Content-Type: application/json'
EOL '\n'
EOL '\n'
BODY '{ "orderId": "'
VARIABLE '{{orderId}}'
BODY '", "note": "'
EOL '\n'
BODY '### this line starts with hashes but sits inside a JSON string'
EOL '\n'
BODY '" }'
EOL '\n'
BODY '   ### indented is body too'
EOL '\n'
BODY '#### four hashes are body'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'sqs'
WHITE_SPACE ' '
WORD 'send'
WHITE_SPACE ' '
TARGET 'queue/inbox'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@attr'
WHITE_SPACE ' '
DIR_VALUE 'id='
VARIABLE '{{orderId}}'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@body'
WHITE_SPACE ' '
DIR_VALUE './payloads/no-newline.json'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'sqs'
WHITE_SPACE ' '
WORD 'receive'
WHITE_SPACE ' '
TARGET 'queue/outbox'
WHITE_SPACE ' '
WORD 'got-it'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@until'
WHITE_SPACE ' '
DIR_VALUE '$.Item.status.S == "ACKED" within 10s'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'dynamodb'
WHITE_SPACE ' '
WORD 'get'
WHITE_SPACE ' '
TARGET 'table/messages'
EOL '\n'
BODY '{ "id": {"S": "'
VARIABLE '{{orderId}}'
BODY '"} }'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'logs'
WHITE_SPACE ' '
TARGET 'log/service-a'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@filter'
WHITE_SPACE ' '
VARIABLE '{{correlation}}'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@for'
WHITE_SPACE ' '
DIR_VALUE '10s'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'lines >= 2'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'wait'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@name'
WHITE_SPACE ' '
DIR_VALUE 'pause'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@for'
WHITE_SPACE ' '
DIR_VALUE '1s'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'sql'
WHITE_SPACE ' '
TARGET 'db/main'
WHITE_SPACE ' '
WORD 'q1'
EOL '\n'
BODY 'select 1;'
EOL '\n'
