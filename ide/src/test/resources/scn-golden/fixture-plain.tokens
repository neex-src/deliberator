COMMENT '# the four plain kinds in one run'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@env'
WHITE_SPACE ' '
DIR_VALUE 'local'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@var'
WHITE_SPACE ' '
DIR_VALUE 'rowId = row-'
VARIABLE '{{uuid}}'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'logs'
WHITE_SPACE ' '
TARGET 'log/pg'
WHITE_SPACE ' '
WORD 'pg-statements'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@filter'
WHITE_SPACE ' '
VARIABLE '{{correlation}}'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@filter'
WHITE_SPACE ' '
DIR_VALUE 'insert into plain_t'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@for'
WHITE_SPACE ' '
DIR_VALUE '8s'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'lines >= 1'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'sql'
WHITE_SPACE ' '
TARGET 'db/main'
WHITE_SPACE ' '
WORD 'make-table'
EOL '\n'
BODY 'create table if not exists plain_t (id text primary key, note text, n int)'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'http'
WHITE_SPACE ' '
WORD 'health'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'status == 200'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'header.content-type contains json'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'bytes > 0'
EOL '\n'
BODY 'GET '
VARIABLE '{{service/floci}}'
BODY '/_floci/health'
EOL '\n'
BODY 'Accept: application/json'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'sql'
WHITE_SPACE ' '
TARGET 'db/main'
WHITE_SPACE ' '
WORD 'insert'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'updated == 1'
EOL '\n'
BODY 'insert into plain_t values (''
VARIABLE '{{rowId}}'
BODY '', 'first note', 7) /* '
VARIABLE '{{correlation}}'
BODY ' */'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'sql'
WHITE_SPACE ' '
TARGET 'db/main'
WHITE_SPACE ' '
WORD 'select'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'rows == 1'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'col.note == first note'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'col.n == 7'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@capture'
WHITE_SPACE ' '
DIR_VALUE 'note = col.note'
EOL '\n'
BODY 'select id, note, n, null as gone from plain_t where id = ''
VARIABLE '{{rowId}}'
BODY '''
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'wait'
WHITE_SPACE ' '
WORD 'pause'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@for'
WHITE_SPACE ' '
DIR_VALUE '1s'
EOL '\n'
