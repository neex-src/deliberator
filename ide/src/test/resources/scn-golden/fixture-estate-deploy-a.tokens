COMMENT '# A real deploy of service A and the address that follows it (B38, decision 67). `{{service/a}}` is an ECS target'
EOL '\n'
COMMENT '# (`{:ecs {:cluster ... :service ... :port ...}}`): the address of the running task is looked up every time a step uses it, so the'
EOL '\n'
COMMENT '# same step reaches the replaced task after the deploy. The deploy is UpdateService with the newest ACTIVE revision of the task'
EOL '\n'
COMMENT '# definition family (`taskDefinition` without a revision) and forceNewDeployment, so it replaces the task also when no new'
EOL '\n'
COMMENT '# revision was registered. Targets used: `service/a`, `ecs/cluster`, `ecs/service-a` (the task definition family is named like the service).'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@env'
WHITE_SPACE ' '
DIR_VALUE 'local'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'http'
WHITE_SPACE ' '
WORD 'health-before'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'status == 200'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.status == UP'
EOL '\n'
BODY 'GET '
VARIABLE '{{service/a}}'
BODY '/actuator/health'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'aws'
WHITE_SPACE ' '
WORD 'ecs.UpdateService'
WHITE_SPACE ' '
WORD 'deploy'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.service.deployments[0].rolloutState == IN_PROGRESS'
EOL '\n'
BODY '{"cluster": "'
VARIABLE '{{ecs/cluster}}'
BODY '", "service": "'
VARIABLE '{{ecs/service-a}}'
BODY '", "taskDefinition": "'
VARIABLE '{{ecs/service-a}}'
BODY '", "forceNewDeployment": true}'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'aws'
WHITE_SPACE ' '
WORD 'ecs.DescribeServices'
WHITE_SPACE ' '
WORD 'rollout'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@until'
WHITE_SPACE ' '
DIR_VALUE '$.services[0].deployments[0].rolloutState == COMPLETED within 300s'
EOL '\n'
BODY '{"cluster": "'
VARIABLE '{{ecs/cluster}}'
BODY '", "services": ["'
VARIABLE '{{ecs/service-a}}'
BODY '"]}'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'aws'
WHITE_SPACE ' '
WORD 'ecs.DescribeServices'
WHITE_SPACE ' '
WORD 'settled'
EOL '\n'
COMMENT '# The replaced task is gone: one deployment, one running task.'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@until'
WHITE_SPACE ' '
DIR_VALUE '$.services[0].runningCount == 1 within 180s'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.services[0].deployments[0].rolloutState == COMPLETED'
EOL '\n'
BODY '{"cluster": "'
VARIABLE '{{ecs/cluster}}'
BODY '", "services": ["'
VARIABLE '{{ecs/service-a}}'
BODY '"]}'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'http'
WHITE_SPACE ' '
WORD 'health-after'
EOL '\n'
COMMENT '# The same address target, a different task.'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@until'
WHITE_SPACE ' '
DIR_VALUE 'status == 200 within 90s'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.status == UP'
EOL '\n'
BODY 'GET '
VARIABLE '{{service/a}}'
BODY '/actuator/health'
EOL '\n'
