HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'logs'
WHITE_SPACE ' '
TARGET 'log/service-a'
WHITE_SPACE '   '
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@filter'
WHITE_SPACE ' '
VARIABLE '{{correlation}}'
WHITE_SPACE '  '
EOL '\n'
EOL '\n'
BODY '  # @for 10s'
EOL '\n'
BODY '# @assert lines >= 2'
EOL '\n'
BODY '# a comment ends the zone'
EOL '\n'
BODY '# @assert now a body line'
EOL '\n'
BODY '{"k": "'
VARIABLE '{{v}}'
BODY ' and {{unclosed"}'
EOL '\n'
