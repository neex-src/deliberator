COMMENT '# One order through the whole estate: inbox queue -> service A (DynamoDB) -> publish -> bus ->'
EOL '\n'
COMMENT '# service B (ack in A, row in Postgres) and the Lambda logger. One id and one correlation id run'
EOL '\n'
COMMENT '# through every step; the log steps are armed before step 1 and filtered by that correlation.'
EOL '\n'
COMMENT '# The second half is the chain: HTTP API -> scheduler-create (Lambda) -> a one-off Scheduler schedule -> ecs-scale (Lambda)'
EOL '\n'
COMMENT '# -> ECS service scaled + SSM parameter put. Checked from the outside: the schedule exists, the service and the parameter'
EOL '\n'
COMMENT '# change, the schedule deletes itself; the correlation id reaches both Lambdas' logs.'
EOL '\n'
COMMENT '# Nothing in the file names an environment: the names of the chain (schedule group, parameter, cluster, service, functions) and the'
EOL '\n'
COMMENT '# waits come from the environment's targets (`scheduler/chain`, `parameter/chain-desired`, `ecs/cluster`, `ecs/service-a`,'
EOL '\n'
COMMENT '# `function/ecs-scale`, `timing/chain`, `timing/logs`), so it runs on the local estate and on a real account under any prefix.'
EOL '\n'
COMMENT '# `timing/chain` is how long the chain may take after the schedule's at() time (Floci: seconds; the real Scheduler fired 23 to 47 s'
EOL '\n'
COMMENT '# late), `timing/logs` how long a log line may need to show up (CloudWatch ingestion).'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@env'
WHITE_SPACE ' '
DIR_VALUE 'local'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@var'
WHITE_SPACE ' '
DIR_VALUE 'corr = '
VARIABLE '{{correlation}}'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@var'
WHITE_SPACE ' '
DIR_VALUE 'msg = ord-'
VARIABLE '{{uuid}}'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@var'
WHITE_SPACE ' '
DIR_VALUE 'param = '
VARIABLE '{{parameter/chain-desired}}'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@var'
WHITE_SPACE ' '
DIR_VALUE 'chain_wait = '
VARIABLE '{{timing/chain}}'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@var'
WHITE_SPACE ' '
DIR_VALUE 'log_wait = '
VARIABLE '{{timing/logs}}'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'sqs'
WHITE_SPACE ' '
WORD 'send'
WHITE_SPACE ' '
TARGET 'queue/inbox'
WHITE_SPACE ' '
WORD 'send-order'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@attr'
WHITE_SPACE ' '
DIR_VALUE 'id='
VARIABLE '{{msg}}'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@attr'
WHITE_SPACE ' '
DIR_VALUE 'correlation='
VARIABLE '{{corr}}'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@body'
WHITE_SPACE ' '
DIR_VALUE '../payloads/01-simple-order.json'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'messageId matches /^[0-9a-f-]{36}$/'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'dynamodb'
WHITE_SPACE ' '
WORD 'get'
WHITE_SPACE ' '
TARGET 'table/messages'
WHITE_SPACE ' '
WORD 'stored'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@until'
WHITE_SPACE ' '
DIR_VALUE '$.status.S == RECEIVED within 20s'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.id.S == '
VARIABLE '{{msg}}'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.correlation.S == '
VARIABLE '{{corr}}'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.bytes.N > 0'
EOL '\n'
BODY '{"Key": {"id": {"S": "'
VARIABLE '{{msg}}'
BODY '"}}}'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'http'
WHITE_SPACE ' '
WORD 'publish'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'status == 200'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.id == '
VARIABLE '{{msg}}'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.correlation == '
VARIABLE '{{corr}}'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@capture'
WHITE_SPACE ' '
DIR_VALUE 'eventId = $.eventId'
EOL '\n'
BODY 'POST '
VARIABLE '{{service/a}}'
BODY '/publish/'
VARIABLE '{{msg}}'
EOL '\n'
BODY 'X-Correlation-Id: '
VARIABLE '{{corr}}'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'dynamodb'
WHITE_SPACE ' '
WORD 'get'
WHITE_SPACE ' '
TARGET 'table/messages'
WHITE_SPACE ' '
WORD 'acked'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@until'
WHITE_SPACE ' '
DIR_VALUE '$.status.S == ACKED within 30s'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.ackedAt.S matches /^20/'
EOL '\n'
BODY '{"Key": {"id": {"S": "'
VARIABLE '{{msg}}'
BODY '"}}}'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'sql'
WHITE_SPACE ' '
TARGET 'db/main'
WHITE_SPACE ' '
WORD 'ack-row'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@until'
WHITE_SPACE ' '
DIR_VALUE 'rows == 1 within 20s'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'col.message_id == '
VARIABLE '{{msg}}'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'col.correlation == '
VARIABLE '{{corr}}'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'col.a_status == 200'
EOL '\n'
BODY 'select message_id, correlation, a_status from acks where message_id = ''
VARIABLE '{{msg}}'
BODY '' /* '
VARIABLE '{{corr}}'
BODY ' */'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'http'
WHITE_SPACE ' '
WORD 'read-back'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'status == 200'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.status == ACKED'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.correlation == '
VARIABLE '{{corr}}'
EOL '\n'
BODY 'GET '
VARIABLE '{{service/a}}'
BODY '/messages/'
VARIABLE '{{msg}}'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'http'
WHITE_SPACE ' '
WORD 'api-log'
EOL '\n'
COMMENT '# The HTTP API in front of the logger Lambda.'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'status == 200'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.ok == true'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.correlation == '
VARIABLE '{{corr}}'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.path == /log'
EOL '\n'
BODY 'GET '
VARIABLE '{{api/main}}'
BODY '/log'
EOL '\n'
BODY 'X-Correlation-Id: '
VARIABLE '{{corr}}'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'aws'
WHITE_SPACE ' '
WORD 'ssm.PutParameter'
WHITE_SPACE ' '
WORD 'chain-reset-param'
EOL '\n'
COMMENT '# Start from a known value, so that a second run of this file proves the chain again.'
EOL '\n'
BODY '{"Name": "'
VARIABLE '{{param}}'
BODY '", "Value": "1", "Type": "String", "Overwrite": true}'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'aws'
WHITE_SPACE ' '
WORD 'ecs.UpdateService'
WHITE_SPACE ' '
WORD 'chain-reset-service'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.service.deploymentController.type matches /^(CODE_DEPLOY|ECS)$/'
EOL '\n'
BODY '{"cluster": "'
VARIABLE '{{ecs/cluster}}'
BODY '", "service": "'
VARIABLE '{{ecs/service-a}}'
BODY '", "desiredCount": 1}'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'http'
WHITE_SPACE ' '
WORD 'chain-schedule'
EOL '\n'
COMMENT '# POST /schedule -> scheduler-create creates the one-off schedule, firing in 8 s.'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'status == 202'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.group == '
VARIABLE '{{scheduler/chain}}'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.schedule == chain-'
VARIABLE '{{msg}}'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.input.desiredCount == 3'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.input.correlation == '
VARIABLE '{{corr}}'
EOL '\n'
BODY 'POST '
VARIABLE '{{api/main}}'
BODY '/schedule'
EOL '\n'
BODY 'X-Correlation-Id: '
VARIABLE '{{corr}}'
EOL '\n'
BODY 'Content-Type: application/json'
EOL '\n'
EOL '\n'
BODY '{"delaySeconds": 8, "desiredCount": 3, "name": "chain-'
VARIABLE '{{msg}}'
BODY '"}'
EOL '\n'
EOL '\n'
