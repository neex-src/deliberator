WORD 'get'
WHITE_SPACE ' '
WORD 'chain-{{msg}}'
WHITE_SPACE ' '
WORD 'schedule-exists'
EOL '\n'
COMMENT '# The schedule is there, enabled, aimed at ecs-scale, and deletes itself after it ran.'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
