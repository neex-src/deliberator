COMMENT '# One order through the whole estate: inbox queue -> service A (DynamoDB) -> publish -> bus ->'
EOL '\n'
COMMENT '# service B (ack in A, row in Postgres) and the Lambda logger. One id and one correlation id run'
EOL '\n'
COMMENT '# through every step; the three log steps are armed before step 1 and filtered by that correlation.'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@env'
WHITE_SPACE ' '
DIR_VALUE 'local'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@var'
WHITE_SPACE ' '
DIR_VALUE 'corr = '
VARIABLE '{{correlation}}'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@var'
WHITE_SPACE ' '
DIR_VALUE 'msg = ord-'
VARIABLE '{{uuid}}'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'sqs'
WHITE_SPACE ' '
WORD 'send'
WHITE_SPACE ' '
TARGET 'queue/inbox'
WHITE_SPACE ' '
WORD 'send-order'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@attr'
WHITE_SPACE ' '
DIR_VALUE 'id='
VARIABLE '{{msg}}'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@attr'
WHITE_SPACE ' '
DIR_VALUE 'correlation='
VARIABLE '{{corr}}'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@body'
WHITE_SPACE ' '
DIR_VALUE '../payloads/01-simple-order.json'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'messageId matches /^[0-9a-f-]{36}$/'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'dynamodb'
WHITE_SPACE ' '
WORD 'get'
WHITE_SPACE ' '
TARGET 'table/messages'
WHITE_SPACE ' '
WORD 'stored'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@until'
WHITE_SPACE ' '
DIR_VALUE '$.status.S == RECEIVED within 20s'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.id.S == '
VARIABLE '{{msg}}'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.correlation.S == '
VARIABLE '{{corr}}'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.bytes.N > 0'
EOL '\n'
BODY '{"Key": {"id": {"S": "'
VARIABLE '{{msg}}'
BODY '"}}}'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'http'
WHITE_SPACE ' '
WORD 'publish'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'status == 200'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.id == '
VARIABLE '{{msg}}'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.correlation == '
VARIABLE '{{corr}}'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@capture'
WHITE_SPACE ' '
DIR_VALUE 'eventId = $.eventId'
EOL '\n'
BODY 'POST '
VARIABLE '{{service/a}}'
BODY '/publish/'
VARIABLE '{{msg}}'
EOL '\n'
BODY 'X-Correlation-Id: '
VARIABLE '{{corr}}'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'dynamodb'
WHITE_SPACE ' '
WORD 'get'
WHITE_SPACE ' '
TARGET 'table/messages'
WHITE_SPACE ' '
WORD 'acked'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@until'
WHITE_SPACE ' '
DIR_VALUE '$.status.S == ACKED within 30s'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.ackedAt.S matches /^20/'
EOL '\n'
BODY '{"Key": {"id": {"S": "'
VARIABLE '{{msg}}'
BODY '"}}}'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'sql'
WHITE_SPACE ' '
TARGET 'db/main'
WHITE_SPACE ' '
WORD 'ack-row'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@until'
WHITE_SPACE ' '
DIR_VALUE 'rows == 1 within 20s'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'col.message_id == '
VARIABLE '{{msg}}'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'col.correlation == '
VARIABLE '{{corr}}'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'col.a_status == 200'
EOL '\n'
BODY 'select message_id, correlation, a_status from acks where message_id = ''
VARIABLE '{{msg}}'
BODY '' /* '
VARIABLE '{{corr}}'
BODY ' */'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'http'
WHITE_SPACE ' '
WORD 'read-back'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'status == 200'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.status == ACKED'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE '$.correlation == '
VARIABLE '{{corr}}'
EOL '\n'
BODY 'GET '
VARIABLE '{{service/a}}'
BODY '/messages/'
VARIABLE '{{msg}}'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'logs'
WHITE_SPACE ' '
TARGET 'log/service-a'
WHITE_SPACE ' '
WORD 'service-a-log'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@filter'
WHITE_SPACE ' '
VARIABLE '{{corr}}'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@for'
WHITE_SPACE ' '
DIR_VALUE '3s'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'lines >= 2'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'logs'
WHITE_SPACE ' '
TARGET 'log/service-b'
WHITE_SPACE ' '
WORD 'service-b-log'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@filter'
WHITE_SPACE ' '
VARIABLE '{{corr}}'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@for'
WHITE_SPACE ' '
DIR_VALUE '3s'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'lines >= 1'
EOL '\n'
EOL '\n'
HEAD_MARK '###'
WHITE_SPACE ' '
KIND 'logs'
WHITE_SPACE ' '
TARGET 'log/logger'
WHITE_SPACE ' '
WORD 'lambda-log'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@filter'
WHITE_SPACE ' '
VARIABLE '{{corr}}'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@for'
WHITE_SPACE ' '
DIR_VALUE '8s'
EOL '\n'
DIR_MARK '#'
WHITE_SPACE ' '
DIR_NAME '@assert'
WHITE_SPACE ' '
DIR_VALUE 'lines >= 1'
EOL '\n'
