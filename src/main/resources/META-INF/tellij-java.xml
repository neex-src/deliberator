<!-- Loaded only when the Java plugin is present: everything that touches Java PSI or the debugger. -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <editorActionHandler action="EditorEscape" order="first, before tellijEscape"
                  implementationClass="com.neex.tellij.java.summary.EndpointSummaryEscapeHandler"/>
        <completion.contributor language="Tellij" order="last"
                  implementationClass="com.neex.tellij.java.controller.JsonBodyCompletion"/>
        <annotator language="Tellij" implementationClass="com.neex.tellij.java.controller.JsonBodyAnnotator"/>
    </extensions>

    <extensions defaultExtensionNs="com.neex.tellij">
        <sourceKind implementation="com.neex.tellij.java.controller.ControllerSource"/>
    </extensions>

    <actions>
        <action id="com.neex.tellij.EndpointSummary" class="com.neex.tellij.java.summary.EndpointSummaryAction"
                text="Tellij: Endpoint Summary"
                description="Show what this Spring MVC method exposes — method, path, params, body, responses — inline under it, read from its interface">
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift E"/>
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="com.neex.tellij.EditorMenu"/>
        </action>
    </actions>
</idea-plugin>
