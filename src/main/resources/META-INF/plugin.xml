<idea-plugin>
    <id>com.neex.tellij</id>
    <name>Tellij Workbench</name>
    <vendor email="dev@neex.dev">NEEX</vendor>
    <description><![CDATA[
        One editor buffer for the whole microservice test loop: publish an event (Kafka/SQS),
        watch the consumer's logs stream in below it, query the database, call an HTTP endpoint —
        all as plain, searchable text in the same <code>.tellij</code> file, connected by the same
        <code>{{variables}}</code>.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="tellij-java.xml">com.intellij.java</depends>

    <extensionPoints>
        <extensionPoint qualifiedName="com.neex.tellij.sourceKind"
                        interface="com.neex.tellij.spi.SourceKind" dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Tellij" implementationClass="com.neex.tellij.lang.TellijFileType"
                  fieldName="INSTANCE" language="Tellij" extensions="tellij"/>
        <lang.parserDefinition language="Tellij" implementationClass="com.neex.tellij.lang.TellijParserDefinition"/>
        <lang.syntaxHighlighterFactory language="Tellij"
                  implementationClass="com.neex.tellij.lang.TellijHighlighterFactory"/>
        <lang.foldingBuilder language="Tellij" implementationClass="com.neex.tellij.editor.TellijFoldingBuilder"/>
        <completion.contributor language="Tellij" implementationClass="com.neex.tellij.editor.TellijCompletionContributor"/>
        <typedHandler implementation="com.neex.tellij.editor.TellijTypedHandler"/>
        <editorFactoryListener implementation="com.neex.tellij.editor.TellijEditorTracker"/>
        <editorActionHandler action="EditorEscape" id="tellijEscape"
                  implementationClass="com.neex.tellij.actions.TellijEscapeHandler" order="first"/>
        <actionPromoter implementation="com.neex.tellij.actions.TellijActionPromoter"/>
    </extensions>

    <extensions defaultExtensionNs="com.neex.tellij">
        <sourceKind implementation="com.neex.tellij.sources.kafka.KafkaSource"/>
        <sourceKind implementation="com.neex.tellij.sources.logs.LogsSource"/>
        <sourceKind implementation="com.neex.tellij.sources.sql.SqlSource"/>
        <sourceKind implementation="com.neex.tellij.sources.sqs.SqsSource"/>
        <sourceKind implementation="com.neex.tellij.sources.http.HttpSource"/>
        <sourceKind implementation="com.neex.tellij.sources.mongo.MongoSource"/>
    </extensions>

    <actions>
        <action id="com.neex.tellij.RunBlock" class="com.neex.tellij.actions.RunBlockAction"
                text="Tellij: Run Block at Caret"
                description="Execute the workbench block under the caret and write its result below it">
            <keyboard-shortcut keymap="$default" first-keystroke="control ENTER"/>
        </action>
        <action id="com.neex.tellij.RunAll" class="com.neex.tellij.actions.RunAllAction"
                text="Tellij: Run All Blocks"
                description="Execute every block top to bottom; log tails are armed first">
            <keyboard-shortcut keymap="$default" first-keystroke="control shift ENTER"/>
        </action>
        <action id="com.neex.tellij.Stop" class="com.neex.tellij.actions.StopAction"
                text="Tellij: Stop Run"
                description="Cancel the running workbench session (Esc does the same)">
            <keyboard-shortcut keymap="$default" first-keystroke="control alt shift F2"/>
        </action>
        <action id="com.neex.tellij.ClearResults" class="com.neex.tellij.actions.ClearResultsAction"
                text="Tellij: Clear All Results"
                description="Remove every result section from the file">
            <keyboard-shortcut keymap="$default" first-keystroke="control alt shift BACK_SPACE"/>
        </action>
        <action id="com.neex.tellij.RunFromCaret" class="com.neex.tellij.actions.RunFromCaretAction"
                text="Tellij: Run From Caret Down"
                description="Execute the block at the caret and every block below it, keeping the variable snapshot">
            <keyboard-shortcut keymap="$default" first-keystroke="control alt shift ENTER"/>
        </action>
        <action id="com.neex.tellij.ClearBlockResult" class="com.neex.tellij.actions.ClearBlockResultAction"
                text="Tellij: Clear Result of Block at Caret"
                description="Remove the result section of the block under the caret">
            <keyboard-shortcut keymap="$default" first-keystroke="control alt BACK_SPACE"/>
        </action>
        <action id="com.neex.tellij.CollapseResults" class="com.neex.tellij.actions.CollapseResultsAction"
                text="Tellij: Collapse All Results"
                description="Fold every result section to its header line (Esc folds the one at the caret)">
            <keyboard-shortcut keymap="$default" first-keystroke="control alt shift MINUS"/>
        </action>
        <action id="com.neex.tellij.ExpandResults" class="com.neex.tellij.actions.ExpandResultsAction"
                text="Tellij: Expand All Results"
                description="Unfold every result section">
            <keyboard-shortcut keymap="$default" first-keystroke="control alt shift EQUALS"/>
        </action>
        <group id="com.neex.tellij.EditorMenu" class="com.neex.tellij.actions.TellijEditorMenu" text="Tellij" popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <reference ref="com.neex.tellij.RunBlock"/>
            <reference ref="com.neex.tellij.RunFromCaret"/>
            <reference ref="com.neex.tellij.RunAll"/>
            <reference ref="com.neex.tellij.Stop"/>
            <separator/>
            <reference ref="com.neex.tellij.CollapseResults"/>
            <reference ref="com.neex.tellij.ExpandResults"/>
            <separator/>
            <reference ref="com.neex.tellij.ClearBlockResult"/>
            <reference ref="com.neex.tellij.ClearResults"/>
        </group>
    </actions>
</idea-plugin>
