# Chapter 12: a repository's Terraform on the local runtime: the override file, the account id, the order of two roots
#
# Chapter 8 ran the estate's own Floci root, which points its providers at the emulator by itself. A real repository's root does
# not: `provider "aws" { region = ... }`, an S3 backend, the real account's ARNs. `terraform.local` makes any root run here by
# writing `deliberator_override.tf.json` next to its `.tf` files (provider endpoints for the services the root uses, fake keys,
# a local state under the workspace), and `terraform.graph` / `terraform.apply-all` order several roots from their text. This
# chapter does it with COPIES of the estate's real-AWS root (`terraform/aws`, no endpoints of its own) and the IAM root it looks a
# role up in (`terraform/iam`), listed in the wrong order on purpose, and destroys them again. The workspace's account id
# (`dlb workspace open --account ID`) is the account of every ARN in Floci; the tour workspace has Floci's own.
# In the IDE: the same operations are in the Operations form (terraform.graph, terraform.apply-all, terraform.locate).
# @env local
# @var prefix = tour12

### shell paths
# @cwd ..
# @capture root = out
pwd | tr -d '\n'

### shell copy-the-roots
# A repository of its own (the ignore line is what a user's checkout has, so the run has no warning to chase).
# @capture copy = out
d=$(mktemp -d /tmp/dlb-tour12-XXXXXX)
tar -C "{{root}}/estate" --exclude=.terraform --exclude=.build --exclude='*.tfstate*' -cf - terraform lambda | tar -C "$d" -xf -
git init -q "$d" && printf 'deliberator_override.tf.json\n.terraform/\n.build/\n' > "$d/.gitignore"
printf %s "$d"

### op terraform.graph order
# Read from the .tf files, nothing evaluated: `aws` has `data "aws_iam_role"` for `estate-shared`, which `iam` declares.
# @assert $.order[0] contains /terraform/iam
# @assert $.edges[0].from == iam
# @assert $.edges[0].to == aws
# @assert $.edges[0].via == data
{"roots": ["{{copy}}/terraform/aws", "{{copy}}/terraform/iam"]}

### op terraform.apply-all apply
# `terraform.local apply` of each root in that order, each with its override file; the state is under the workspace, the copy has none.
# @timeout 8m
# @assert $.ok == true
# @assert $.results[0].summary contains Apply complete
# @assert $.results[1].summary contains Apply complete
{"roots": ["{{copy}}/terraform/aws", "{{copy}}/terraform/iam"], "vars": {"prefix": "{{prefix}}"}}

### shell the-override-file
# The file is the user's from now on (never removed, rewritten only while it carries the generated marker line).
# @assert out contains Generated by Deliberator
# @assert out contains "sqs"
# @assert out contains deliberator_override.tf.json
f="{{copy}}/terraform/aws/deliberator_override.tf.json"
head -c 120 "$f"; echo ...
grep -o '"sqs": *"[^"]*"' "$f"
ls "{{copy}}/terraform/aws"

### aws sts.GetCallerIdentity who
# Floci's account is the workspace's (`env.account`); with `workspace open --account` it is the real one.
# @assert $.Account == {{env.account}}
{}

### aws iam.GetRole the-role
# The role the IAM root created, with the account in its ARN.
# @assert $.Role.Arn contains :role/estate-shared
{"RoleName": "estate-shared"}

### op terraform.drift clean
# Drift of the copy reads its state through the root's own data dir (under the workspace).
# @assert $.missing == []
# @assert $.declared > 10
{"dir": "{{copy}}/terraform/aws"}

### op terraform.locate where
# What a drift row's address is for: the declaration, in the module's directory.
# @assert $.file contains modules/stack/main.tf
# @assert $.line > 1
{"root": "{{copy}}/terraform/aws", "address": "module.stack.aws_sqs_queue.inbox"}

### op terraform.apply-all destroy
# Destroy runs the other way round (aws first, then iam).
# @timeout 8m
# @assert $.ok == true
# @assert $.order[0] contains /terraform/aws
{"roots": ["{{copy}}/terraform/aws", "{{copy}}/terraform/iam"], "action": "destroy", "vars": {"prefix": "{{prefix}}"}}

### shell clean-up
rm -rf "{{copy}}"
