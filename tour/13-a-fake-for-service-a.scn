# Chapter 13: a fake for service A - record the real traffic once, then the real one is not needed
#
# Chapter 6 switched A off or pointed it elsewhere. A third answer to "who serves A" is a fake: a small proxy container on the
# runtime's network (a babashka record/replay reverse proxy) that stands in for A. In `record` mode it forwards to the real A and writes
# every request and response, raw, to `sessions/<key>/fakes/a/<stamp>/NNNNN.json` BEFORE it answers (principle 1: nothing is
# kept in memory only); the topology mode `fake` points A's callers at it: B reads A's URL from SERVICE_A_URL, so B is recreated
# with the fake's address and its `POST /ack/<id>` goes B -> fake -> A. In `replay` mode the fake answers from the recording and A
# is not needed: it is stopped. A request is matched by method+path+query, then method+path, then by the TEMPLATE of the recorded
# path (ids, uuids and long digit runs are wildcards), so an order id that was never recorded is still acked; a request nobody
# recorded is a 404 that says so. Recordings are text files; `fake.commit` copies one into a repository with the tokens, API keys,
# e-mails and person names scrubbed by rule and a report that counts and never lists values; the raw recording stays here.
# In the IDE: not yet (the operations are in the Operations form: fake.record, fake.replay, fake.stop, fake.list, fake.commit).
# @env local
# @var corr = {{correlation}}
# @var msg = ord-{{uuid}}
# @var fresh = ord-{{uuid}}

### shell paths
# @cwd ..
# @capture root = out
pwd | tr -d '\n'

### op fake.record record-a
# `service/a` is the upstream as the fake's container sees it. A session is needed: the recording lives under it.
# @timeout 5m
# @assert $.mode == record
# @assert $.recording contains /fakes/a/
# @assert $.container-url contains fake-a:8080
# @capture fake = $.url
{"name": "a", "upstream": "service/a"}

### op topology.set a-is-the-fake
# Only the record. B depends on A, so B is reported; A itself stays (it is the fake's upstream while it records).
# @assert $.services.a.mode == fake
# @assert $.dependents[0].name == b
{"env": "local", "name": "a", "mode": "fake"}

### op runtime.ensure b-calls-the-fake
# B is recreated with SERVICE_A_URL = the fake's container URL.
# @timeout 5m
{}

### sqs send queue/inbox send-order
# The order story of chapter 2, now with the fake in front of A: {{service/a}} is the fake for the scenario's own calls too.
# @attr id={{msg}}
# @attr correlation={{corr}}
# @body ../estate/payloads/01-simple-order.json
# @assert messageId matches /^[0-9a-f-]{36}$/

### dynamodb get table/messages stored
# @until $.status.S == RECEIVED within 30s
# @assert $.id.S == {{msg}}
{"Key": {"id": {"S": "{{msg}}"}}}

### http publish
# Scenario -> fake -> A.
# @assert status == 200
# @assert $.id == {{msg}}
POST {{service/a}}/publish/{{msg}}
X-Correlation-Id: {{corr}}

### dynamodb get table/messages acked
# B -> fake -> A: the ack that is going to be replayed.
# @until $.status.S == ACKED within 40s
{"Key": {"id": {"S": "{{msg}}"}}}

### sql db/main ack-row
# @until rows == 1 within 20s
# @assert col.a_status == 200
select message_id, correlation, a_status from acks where message_id = '{{msg}}' /* {{corr}} */

### op fake.list recorded
# At least the publish and the ack went through (the dynamodb read goes to Floci, not through the fake).
# @assert $[0].name == a
# @assert $[0].mode == record
# @assert $[0].exchanges >= 2
# @assert $[0].attached[0].service == a
{}

### shell the-recording-is-text
# One file per exchange, raw: the API key B sent is in it, and the path is there with its template. (This is why a recording is
# not committed as it is.)
# @assert out contains 00001.json
# @assert out contains "/ack/ord-{}"
# @assert out contains x-api-key
d=$(ls -d "$DELIBERATOR_HOME/workspaces/$DLB_WS/sessions/$DLB_SESSION"/fakes/a/* | tail -1)
ls "$d" | head -3
grep -h '"path-template"' "$d"/*.json | sort -u
grep -l '"x-api-key"' "$d"/*.json | head -1 | xargs grep -h -o '"x-api-key"'

### op fake.replay replay-a
# The fake now serves the newest recording. A is served by a fake that replays, so its container is not desired: stopped by the
# reconcile this call ends with.
# @timeout 5m
# @assert $.mode == replay
# @assert $.serving == replay
# @assert $.exchanges >= 2
{"name": "a"}

### op service.status a-is-not-running
# @assert $[0].status == fake
{"name": "a"}

### shell a-itself-is-down
# Not the fake: the real A's host port answers nobody (the fake has its own port).
# @assert out contains 000
curl -s -o /dev/null -m 3 -w '%{http_code}' http://localhost:8081/actuator/health; echo

### sqs send queue/b-events replayed-order
# An order id nobody ever recorded, straight into B's queue (the envelope the bus delivers); A is stopped, the fake answers the ack.
# @assert messageId matches /^[0-9a-f-]{36}$/
{"version": "0", "id": "{{uuid}}", "source": "estate.service-a", "detail-type": "payload.published",
 "detail": {"id": "{{fresh}}", "correlation": "{{corr}}"}}

### sql db/main fresh-ack-row
# B stored the ack: status 200 came from the recording, by template (`/ack/{}`), with A down.
# @until rows == 1 within 40s
# @assert col.a_status == 200
select message_id, correlation, a_status from acks where message_id = '{{fresh}}' /* {{corr}} */

### http fake-answers-with-its-match
# The scenario's own call reaches the fake too ({{service/a}} is its URL): a request nobody recorded.
# @assert status == 404
# @assert $.error contains no recording matches
# @assert header.x-fake-match == none
GET {{service/a}}/never-recorded

### shell committing-a-copy
# A scrubbed copy into a repository: here a fresh git repository in /tmp. The report counts, it never lists values.
# @capture repo = out
d=$(mktemp -d /tmp/dlb-tour13-XXXXXX); git init -q "$d"; printf %s "$d"

### op fake.commit commit
# @assert $.exchanges >= 2
# @assert $.report contains header:x-api-key
{"name": "a", "repo": "{{repo}}"}

### shell the-copy-is-scrubbed
# @assert out contains <scrubbed>
# @assert out contains scrub-report
f=$(ls "{{repo}}"/fakes/a/*.json | head -1)
! grep -q 'x-api-key": "[^<]' {{repo}}/fakes/a/*.json && echo "no raw api key in the copy"; grep -h -o '<scrubbed>' "$f" | head -1; ls "{{repo}}/fakes/a" | grep scrub-report; rm -rf "{{repo}}"

### op fake.stop stop-a-fake
# The fake's container goes, A is local again, B is recreated against the real A, A starts. The recording stays under the session.
# @timeout 5m
# @assert $.stopped == true
# @assert $.detached[0].service == a
{"name": "a"}

### http {{service/a}}/actuator/health a-is-back
# @until status == 200 within 90s
GET {{service/a}}/actuator/health
