{:paths ["bb" "cli/src" "cli/test"]
 :tasks
 {core:build {:doc "Build core/target/deliberatord.jar (AOT uberjar)"
              :task (shell {:dir "core"} "clojure -T:build uber")}
  core:test {:doc "Run the core tests (clojure -M:test in core/). Pass A of the full recipe: with the estate DOWN the runtime tests own host ports 14566/15432; tests that need an already running Floci (DLB_TEST_FLOCI_URL, default :14566) skip. `bb core:test:all` runs both passes."
             :task (shell {:dir "core"} "clojure -M:test")}
  core:test:all {:doc "Both passes of the core suite: A = bb core:test with the estate down; B = estate up (--ws W, default \"default\"), then the Floci-dependent namespaces and the ESTATE_WS end-to-end test against it; estate down again unless --keep"
                 :requires ([core-test-all])
                 :task (apply core-test-all/-main *command-line-args*)}
  core:test:known-bugs {:doc "Only the audit's tests of known product bugs (^:known-bug), excluded from core:test; see docs/plans/m1-test-report.md"
                        :task (shell {:dir "core"} "clojure -M:test:known-bugs")}
  check:arch {:doc "Layering rules: core, cli, ide separation, no employer names"
              :requires ([check-arch])
              :task (check-arch/-main)}
  runtime:up {:doc "Reconcile the local runtime (Floci, Postgres) through the daemon; args: --ws NAME (default \"default\"), --infra, --no-daemon (one-shot JVM)"
              :requires ([daemon-client])
              :task (apply daemon-client/-main "up" *command-line-args*)}
  runtime:status {:doc "Show the local runtime's containers and health (through the daemon; --no-daemon for a one-shot JVM)"
                  :requires ([daemon-client])
                  :task (apply daemon-client/-main "status" *command-line-args*)}
  runtime:down {:doc "Remove this workspace's runtime containers (through the daemon; --no-daemon for a one-shot JVM)"
                :requires ([daemon-client])
                :task (apply daemon-client/-main "down" *command-line-args*)}
  estate:build {:doc "Build the estate services (Maven, JDK 21)"
                :requires ([estate])
                :task (estate/build)}
  estate:deploy {:doc "terraform apply on Floci + write the service roles into runtime.edn; args: --ws W [--auto-publish] [--no-daemon]"
                 :requires ([estate])
                 :task (estate/deploy *command-line-args*)}
  estate:up {:doc "Runtime (Floci, Postgres) -> deploy -> services; args: --ws W [--auto-publish] [--no-daemon]"
             :requires ([estate])
             :task (estate/up *command-line-args*)}
  estate:status {:doc "Runtime status and the services' health; args: --ws W"
                 :requires ([estate])
                 :task (estate/status *command-line-args*)}
  estate:down {:doc "Remove the workspace's containers and the Floci root's Terraform state; args: --ws W"
               :requires ([estate])
               :task (estate/down *command-line-args*)}
  acceptance {:doc "M1 acceptance: estate up if needed, session ACCEPT-<date>, run every scenario in estate/scenarios; args: --ws W [--down]"
              :requires ([acceptance])
              :task (apply acceptance/-main *command-line-args*)}
  ide:build {:doc "Build the plugin zip ide/build/distributions/deliberator-*.zip (builds the core jar first, lib/deliberatord.jar inside)"
             :task (shell {:dir "ide"} "./gradlew" "buildPlugin")}
  ide:test {:doc "Fixture tests of the plugin (JUnit on the platform test framework; real daemon on temp homes under ide/build/test-homes); extra args go to Gradle"
            :task (apply shell {:dir "ide"} "./gradlew" "test" *command-line-args*)}
  ide:run {:doc "Open the sandbox IDE with the plugin (a GUI: needs a display); sandbox under ide/build/"
           :task (shell {:dir "ide"} "./gradlew" "runIde")}
  ide:verify {:doc "Run the plugin verifier against the recommended IDEs"
              :task (shell {:dir "ide"} "./gradlew" "verifyPlugin")}
  cli:test {:doc "Layer-4 tests of dlb against a real daemon (builds the jar if missing); --known-bugs runs only the audit's :known-bug tests"
            :requires ([cli-test])
            :task (apply cli-test/-main *command-line-args*)}
  cli:install {:doc "Symlink cli/dlb into ~/.local/bin"
               :requires ([cli-install])
               :task (cli-install/-main)}}}
