{:paths ["bb" "cli/src" "cli/test"]
 :tasks
 {core:build {:doc "Build core/target/deliberatord.jar (AOT uberjar)"
              :task (shell {:dir "core"} "clojure -T:build uber")}
  core:test {:doc "Run the core tests (clojure -M:test in core/)"
             :task (shell {:dir "core"} "clojure -M:test")}
  check:arch {:doc "Layering rules: core, cli, ide separation, no employer names"
              :requires ([check-arch])
              :task (check-arch/-main)}
  runtime:up {:doc "Reconcile the local runtime (Floci, Postgres); args: --ws NAME (default \"default\")"
              :task (apply shell {:dir "core"} "clojure" "-M" "-m" "deliberator.runtime" "up" *command-line-args*)}
  runtime:status {:doc "Show the local runtime's containers and health"
                  :task (apply shell {:dir "core"} "clojure" "-M" "-m" "deliberator.runtime" "status" *command-line-args*)}
  runtime:down {:doc "Remove this workspace's runtime containers"
                :task (apply shell {:dir "core"} "clojure" "-M" "-m" "deliberator.runtime" "down" *command-line-args*)}
  estate:build {:doc "Build the estate services (Maven, JDK 21)"
                :requires ([estate])
                :task (estate/build)}
  estate:deploy {:doc "terraform apply on Floci + write the service roles into runtime.edn; args: --ws W [--auto-publish]"
                 :requires ([estate])
                 :task (estate/deploy *command-line-args*)}
  estate:up {:doc "Runtime (Floci, Postgres) -> deploy -> services; args: --ws W [--auto-publish]"
             :requires ([estate])
             :task (estate/up *command-line-args*)}
  estate:status {:doc "Runtime status and the services' health; args: --ws W"
                 :requires ([estate])
                 :task (estate/status *command-line-args*)}
  estate:down {:doc "Remove the workspace's containers and the Floci root's Terraform state; args: --ws W"
               :requires ([estate])
               :task (estate/down *command-line-args*)}
  acceptance {:doc "M1 acceptance: estate up if needed, session ACCEPT-<date>, run every scenario in estate/scenarios; args: --ws W [--down]"
              :requires ([acceptance])
              :task (apply acceptance/-main *command-line-args*)}
  cli:test {:doc "Layer-4 tests of dlb against a real daemon (builds the jar if missing); --known-bugs runs only the audit's :known-bug tests"
            :requires ([cli-test])
            :task (apply cli-test/-main *command-line-args*)}
  cli:install {:doc "Symlink cli/dlb into ~/.local/bin"
               :requires ([cli-install])
               :task (cli-install/-main)}}}
