{:paths ["bb" "cli/src" "cli/test"]
 :tasks
 {core:build {:doc "Build core/target/deliberatord.jar (AOT uberjar)"
              :task (shell {:dir "core"} "clojure -T:build uber")}
  core:test {:doc "Run the core tests (clojure -M:test in core/). Pass A of the full recipe: with the estate DOWN the runtime tests own host ports 14566/15432; tests that need an already running Floci (DLB_TEST_FLOCI_URL, default :14566) skip. `bb core:test:all` runs both passes."
             :requires ([core-build])
             :task (do (core-build/ensure-jar!) (shell {:dir "core" :extra-env {"DELIBERATOR_LOCAL_ENDPOINT" (or (System/getenv "DLB_TEST_FLOCI_URL") "http://localhost:19")}} "clojure -M:test"))}
  core:test:all {:doc "Both passes of the core suite: A = bb core:test with the estate down (its SKIPs are the estate-gated tests, counted); B = estate up (--ws W, default \"default\"), then every namespace that uses deftest-floci or estate-ws (derived, not listed) against it, red on any SKIP; estate down again unless --keep"
                 :requires ([core-test-all])
                 :task (apply core-test-all/-main *command-line-args*)}
  core:test:known-bugs {:doc "Only the tests of known product bugs (^:known-bug, excluded from core:test); exit 0 when there are none and BUGS.md pins none, or when all of them fail as they must; exit 1 when one passes (fixed: drop the tag) or BUGS.md's pinned list disagrees"
                        :requires ([known-bugs])
                        :task (known-bugs/-main)}
  claude:settings {:doc "Append the allow rules of .claude/dev-settings.json to <DIR>/.claude/settings.local.json (default: the repo root; name the directory Claude Code starts in, e.g. `bb claude:settings ..`); prints the claude --settings line for its autoMode part (never touches user settings)"
                   :requires ([claude-settings])
                   :task (apply claude-settings/-main *command-line-args*)}
  check:arch {:doc "Layering rules: core, cli, ide separation, no employer names (the list is ~/.config/deliberator/forbidden-names.txt; fails when it is missing on a machine marked by ~/.config/deliberator/owner-machine, skips with a message elsewhere)"
              :requires ([check-arch])
              :task (check-arch/-main)}
  check:all {:doc "The whole integration test: check:arch, core:test:all (A, then B on the estate of --ws W, default \"check\"), cli:test with the estate up, tour, acceptance; a summary table; the estate down afterwards. Home $DELIBERATOR_HOME, else .scratch/check-home. Run under .scratch/runtime.lock"
             :requires ([check-all])
             :task (apply check-all/-main *command-line-args*)}
  runtime:up {:doc "Reconcile the local runtime (Floci, Postgres) through the daemon; args: --ws NAME (default \"default\"), --infra, --no-daemon (one-shot JVM)"
              :requires ([daemon-client])
              :task (apply daemon-client/-main "up" *command-line-args*)}
  runtime:status {:doc "Show the local runtime's containers and health (through the daemon; --no-daemon for a one-shot JVM)"
                  :requires ([daemon-client])
                  :task (apply daemon-client/-main "status" *command-line-args*)}
  runtime:down {:doc "Remove this workspace's runtime containers (through the daemon; --no-daemon for a one-shot JVM)"
                :requires ([daemon-client])
                :task (apply daemon-client/-main "down" *command-line-args*)}
  estate:image {:doc "Rebuild the hotswap service image (JBR 21 + HotswapAgent, estate/images/jbr21); estate:build builds it only when missing"
                :requires ([estate])
                :task (estate/image true)}
  estate:build {:doc "Build the hotswap service image when missing, then the estate services (Maven, JDK 21)"
                :requires ([estate])
                :task (estate/build)}
  estate:real-images {:doc "Build the two service images with Podman and push them to the ECR repositories of the real estate (run_services); args: --prefix P --profile PROFILE [--tag T] [--only a|b]"
                      :requires ([estate-real])
                      :task (estate-real/images *command-line-args*)}
  estate:deploy {:doc "terraform apply on Floci + write the service roles into runtime.edn; args: --ws W [--auto-publish] [--no-daemon]"
                 :requires ([estate])
                 :task (estate/deploy *command-line-args*)}
  estate:up {:doc "Runtime (Floci, Postgres) -> deploy -> services; args: --ws W [--auto-publish] [--no-daemon]"
             :requires ([estate])
             :task (estate/up *command-line-args*)}
  estate:status {:doc "Runtime status and the services' health; args: --ws W"
                 :requires ([estate])
                 :task (estate/status *command-line-args*)}
  estate:down {:doc "Remove the workspace's containers and the Floci root's Terraform state; args: --ws W"
               :requires ([estate])
               :task (estate/down *command-line-args*)}
  tour:ide {:doc "Open the tour in the sandbox IDE, nothing to set first: home $DELIBERATOR_HOME else .scratch/tour-home, workspace tour (created), this checkout attached, tour/01-estate.scn open"
            :requires ([ide-run])
            :task (ide-run/tour-ide)}
  tour {:doc "The tour as an integration test: every tour/NN-*.scn in order, one session TOUR-<date>; chapter 01 brings the estate up; args: [--ws W (default tour)] [--only N] [--from N] [--down]"
        :requires ([tour])
        :task (apply tour/-main *command-line-args*)}
  acceptance {:doc "M1 acceptance: estate up if needed, session ACCEPT-<date>, run every scenario in estate/scenarios; args: --ws W [--down]"
              :requires ([acceptance])
              :task (apply acceptance/-main *command-line-args*)}
  ide:build {:doc "Build the plugin zip ide/build/distributions/deliberator-*.zip (builds the core jar first, lib/deliberatord.jar inside)"
             :task (shell {:dir "ide"} "./gradlew" "buildPlugin")}
  ide:test {:doc "Fixture tests of the plugin (JUnit on the platform test framework; real daemon on temp homes under ide/build/th); --group a|b runs half of the test packages (each half fits one 10-minute call; the groups must cover the packages on disk); --known-bugs runs only the @Category(KnownBug) tests (./gradlew knownBugs); extra args go to Gradle"
            :requires ([ide-test])
            :task (apply ide-test/-main *command-line-args*)}
  ide:run {:doc "Open the sandbox IDE with the plugin (a GUI: needs a display); args: [--ws W] [--home H] [--open FILE] -> DELIBERATOR_HOME=H and the project <H>/workspaces/<W>/project (created when missing); reuses a daemon already holding H"
           :requires ([ide-run])
           :task (apply ide-run/-main *command-line-args*)}
  ide:verify {:doc "Run the plugin verifier against the recommended IDEs"
              :task (shell {:dir "ide"} "./gradlew" "verifyPlugin")}
  cli:test {:doc "Layer-4 tests of dlb against a real daemon (the jar rebuilt when stale); --only NAME runs the tests whose name contains NAME; SKIPs are printed and counted (with ESTATE_WS and DELIBERATOR_HOME set the estate-gated test runs); --known-bugs runs only the :known-bug tests and exits by their contract (decision 24, see core:test:known-bugs)"
            :requires ([cli-test])
            :task (apply cli-test/-main *command-line-args*)}
  cli:install {:doc "Symlink cli/dlb into ~/.local/bin"
               :requires ([cli-install])
               :task (cli-install/-main)}}}
