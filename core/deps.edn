{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        com.cognitect.aws/api {:mvn/version "0.8.847"}
        com.cognitect.aws/endpoints {:mvn/version "871.2.55.12"}
        com.cognitect.aws/sqs {:mvn/version "871.2.34.1"}
        com.cognitect.aws/dynamodb {:mvn/version "871.2.55.11"}
        com.cognitect.aws/lambda {:mvn/version "871.2.54.18"}
        com.cognitect.aws/eventbridge {:mvn/version "871.2.55.7"}
        com.cognitect.aws/scheduler {:mvn/version "871.2.29.35"}
        com.cognitect.aws/ssm {:mvn/version "871.2.55.7"}
        com.cognitect.aws/secretsmanager {:mvn/version "871.2.40.9"}
        com.cognitect.aws/logs {:mvn/version "871.2.55.11"}
        com.cognitect.aws/sts {:mvn/version "871.2.54.18"}
        com.cognitect.aws/ecs {:mvn/version "871.2.55.16"}
        com.cognitect.aws/ec2 {:mvn/version "871.2.55.11"}
        com.cognitect.aws/codedeploy {:mvn/version "871.2.54.18"}
        com.cognitect.aws/s3 {:mvn/version "871.2.55.11"}
        com.cognitect.aws/sns {:mvn/version "871.2.55.2"}
        com.cognitect.aws/states {:mvn/version "871.2.54.13"}
        com.cognitect.aws/kms {:mvn/version "871.2.44.12"}
        com.cognitect.aws/kinesis {:mvn/version "871.2.55.7"}
        com.cognitect.aws/monitoring {:mvn/version "871.2.55.7"}
        com.cognitect.aws/cloudformation {:mvn/version "871.2.50.3"}
        com.cognitect.aws/iam {:mvn/version "871.2.53.2"}
        org.clojure/data.json {:mvn/version "2.5.2"}
        clj-commons/clj-yaml {:mvn/version "1.0.29"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}
        org.postgresql/postgresql {:mvn/version "42.7.7"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner" "-e" ":known-bug"]
         :exec-fn cognitect.test-runner.api/test}
  ;; `clojure -M:test:known-bugs`: only the audit's tests of known product bugs
  :known-bugs {:main-opts ["-m" "cognitect.test-runner" "-i" ":known-bug"]}
  :dev {:extra-paths ["test"]
        :extra-deps {nrepl/nrepl {:mvn/version "1.5.1"}}}
  :build {:deps {io.github.clojure/tools.build
                 {:git/tag "v0.9.6" :git/sha "8e78bcc"}}
          :ns-default build}}}
